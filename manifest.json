{
  "manifest_version": 3,
  "name": "Aspect Ratio Changer for YouTube™",
  "version": "1.0.0",
  "description": "Change the aspect ratio, zoom, and stretch settings of YouTube videos directly from the video player controls.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "36": "icons/icon36.png",
    "48": "icons/icon48.png",
    "64": "icons/icon64.png",
    "96": "icons/icon96.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*"
      ],
      "all_frames": true,
      "run_at": "document_end",
      "js": [
        "dist/content.js"
      ]
    }
  ]
}